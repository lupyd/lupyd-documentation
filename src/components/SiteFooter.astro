const isExternal = (href: string) => href.startsWith('http');
---

<footer class="site-footer not-content print:hidden">
	<div class="inner">
		<div class="top">
			<div class="brand">
				<a href="https://lupyd.com" class="wordmark">Lupyd</a>
				<p>The workspace where nothing leaks. Private by design, connected by default.</p>
			</div>
			<div class="columns">
				{
					columns.map((col) => (
						<div>
							<h2>{col.title}</h2>
							<ul>
								{col.links.map((link) => (
									<li>
										<a
											href={link.href}
											{...(isExternal(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
							{col.title === 'Connect' && (
								<address>
									Lupyd Media Private Limited
									<br />
									15-18-276/5/A/1, Prashanti Nagar 2,
									<br />
									Khammam – 507002, Telangana, India
								</address>
							)}
						</div>
					))
				}
			</div>
		</div>
		<div class="bottom">
			<p>&copy; {year} Lupyd. Developed with focus on security. · <a href="/sitemap/">Sitemap</a></p>
			<div class="socials">
				{
					socials.map((s) => (
						<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
								<path d={s.path} />
							</svg>
						</a>
					))
				}
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		/* Sit above Starlight's fixed table-of-contents column. */
		position: relative;
		z-index: 2;
		margin-top: 4rem;
		border-top: 1px solid var(--sl-color-hairline-shade);
		background-color: var(--sl-color-bg);
		padding: 3rem var(--sl-nav-pad-x) 2rem;
		font-size: var(--sl-text-sm);
	}
	.inner {
		max-width: 80rem;
		margin-inline: auto;
	}
	.top {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}
	.brand {
		max-width: 28rem;
	}
	.wordmark {
		font-size: 1.5rem;
		font-weight: 900;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.brand p {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
	}
	.columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}
	h2 {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-white);
		margin-bottom: 1rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.6rem;
	}
	ul a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition: color 0.15s;
	}
	ul a:hover {
		color: var(--sl-color-white);
	}
	address {
		margin-top: 1rem;
		font-style: normal;
		font-size: var(--sl-text-xs);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.bottom {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}
	.bottom p {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.bottom p a {
		color: inherit;
	}
	.bottom p a:hover {
		color: var(--sl-color-white);
	}
	.socials {
		display: flex;
		gap: 0.5rem;
	}
	.socials a {
		display: inline-flex;
		padding: 0.6rem;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-hairline);
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		transition: color 0.15s, transform 0.15s;
	}
	.socials a:hover {
		color: var(--sl-color-white);
		transform: scale(1.05);
	}

	@media (min-width: 40rem) {
		.columns {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.bottom {
			flex-direction: row;
			justify-content: space-between;
		}
	}
	@media (min-width: 72rem) {
		.top {
			flex-direction: row;
			justify-content: space-between;
		}
	}
</style>
